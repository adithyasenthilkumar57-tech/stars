# ClearWay AI — Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================
# EXTERNAL API KEYS (fill these in to enable AI / Firebase)
# ============================================================

# Featherless AI API Key (OpenAI-compatible)
# Starts with rc_
FEATHERLESS_API_KEY=rc_your_featherless_api_key_here
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Google Gemini API Key (optional fallback)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Firebase Service Account JSON — paste the entire JSON content as a single line
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_JSON={}

# Firebase Web Config — for the frontend Auth SDK
# Get from: Firebase Console → Project Settings → General → Your Apps → Web App → Config
FIREBASE_WEB_API_KEY=YOUR_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef

# ============================================================
# APPLICATION SETTINGS
# ============================================================

# Data mode: DEMO | SIMULATION | LIVE
DATA_MODE=DEMO

# Application environment
ENVIRONMENT=development

# Backend URL (used by frontend)
BACKEND_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ============================================================
# INFRASTRUCTURE
# ============================================================

# Redis URL (for Celery / caching)
REDIS_URL=redis://localhost:6379/0

# Secret key for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-this-in-production

# ============================================================
# FEATURE FLAGS
# ============================================================

# Enable/disable services (true/false)
ENABLE_QUANTUM=true
ENABLE_AUDIO_DETECTION=true
ENABLE_VISION=true
ENABLE_GEMINI=true

# Quantum optimization depth (QAOA layers)
QAOA_LAYERS=2

# Siren detection confidence threshold (0.0-1.0)
SIREN_CONFIDENCE_THRESHOLD=0.75

# Simulation tick interval (seconds)
SIM_TICK_INTERVAL=1.0

# Number of demo intersections (4-8)
DEMO_INTERSECTION_COUNT=6
